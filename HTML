<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SKYFALL — Sky Survival</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Spectral:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0c0f1e; --bg-deep:#070911;
    --panel:#161b34; --panel-alt:#1e2544;
    --border:#323a63; --border-dim:#232a4a;
    --text:#e8e2d2; --text-dim:#8890b2;
    --moss:#7a9a63; --ember:#c15b3a; --gold:#d3ab52; --sky:#5a86b8; --frost:#7fb0c9; --purple:#9d7fc9;
    --danger-glow: rgba(193,91,58,0.35);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background: radial-gradient(ellipse at 50% -10%, #1a2148 0%, var(--bg) 45%), var(--bg);
    color:var(--text); font-family:'IBM Plex Sans', sans-serif; min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:1160px;margin:0 auto;padding:24px 18px 60px;}
  header{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1px solid var(--border-dim);padding-bottom:14px;margin-bottom:20px;flex-wrap:wrap;gap:10px;}
  h1{font-family:'Spectral',serif;font-weight:700;font-size:1.7rem;letter-spacing:0.04em;margin:0;color:var(--text);}
  h1 span{color:var(--gold);}
  .subtitle{font-size:0.72rem;letter-spacing:0.14em;color:var(--text-dim);text-transform:uppercase;margin-top:2px;}
  .day-counter{font-family:'IBM Plex Mono',monospace;font-size:0.8rem;color:var(--text-dim);border:1px solid var(--border-dim);padding:6px 12px;border-radius:2px;background:var(--panel);text-align:right;}
  .day-counter b{color:var(--sky);}
  .day-counter .trial-note{display:block;font-size:0.68rem;color:var(--ember);margin-top:2px;}

  .grid{display:grid;grid-template-columns:270px 1fr;gap:18px;}
  @media (max-width:820px){.grid{grid-template-columns:1fr;}}

  .panel{background:var(--panel);border:1px solid var(--border-dim);border-radius:3px;padding:16px;}
  .panel + .panel{margin-top:14px;}
  .panel-title{font-family:'IBM Plex Mono',monospace;font-size:0.68rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-dim);margin:0 0 12px;display:flex;justify-content:space-between;align-items:center;}

  .lvl-row{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:6px;}
  .lvl-row .lvl{font-family:'Spectral',serif;font-size:1.4rem;font-weight:600;color:var(--gold);}
  .bar-track{background:var(--bg-deep);border:1px solid var(--border-dim);border-radius:2px;height:7px;overflow:hidden;margin-bottom:10px;}
  .bar-fill{height:100%;transition:width .35s ease;}
  .bar-fill.xp{background:linear-gradient(90deg,#5a86b8,#7fa8d6);}
  .bar-fill.health{background:linear-gradient(90deg,#a13a3a,#d65d5d);}
  .bar-fill.hunger{background:linear-gradient(90deg,#7a9a63,#9bc27c);}
  .bar-fill.thirst{background:linear-gradient(90deg,#3a6a8a,#5fa0c9);}
  .bar-fill.stamina{background:linear-gradient(90deg,#8a7a3a,#d3ab52);}
  .bar-fill.temp{background:linear-gradient(90deg,#5a86b8,#c15b3a);}
  .bar-fill.weight{background:linear-gradient(90deg,#6e5a94,#9d7fc9);}
  .bar-fill.low{filter:brightness(0.7) saturate(1.4);}
  .bar-label{display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:0.65rem;color:var(--text-dim);margin-bottom:3px;}

  .attrs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px;}
  .attr{background:var(--bg-deep);border:1px solid var(--border-dim);padding:7px 9px;border-radius:2px;display:flex;justify-content:space-between;align-items:center;}
  .attr-name{font-size:0.66rem;color:var(--text-dim);letter-spacing:0.03em;}
  .attr-val{font-family:'IBM Plex Mono',monospace;font-weight:600;color:var(--text);font-size:0.85rem;}
  .attr-plus{width:18px;height:18px;border-radius:2px;border:1px solid var(--gold);color:var(--gold);background:transparent;font-size:0.75rem;cursor:pointer;line-height:1;display:none;}
  .attr-plus.show{display:inline-block;}
  .attr-plus:hover{background:var(--gold);color:var(--bg-deep);}
  .points-banner{font-family:'IBM Plex Mono',monospace;font-size:0.7rem;color:var(--gold);border:1px dashed var(--gold);padding:6px 8px;border-radius:2px;margin-top:10px;text-align:center;display:none;}
  .points-banner.show{display:block;}

  .res-list{display:flex;flex-direction:column;gap:5px;}
  .res-row{display:flex;justify-content:space-between;font-size:0.8rem;padding:3px 0;border-bottom:1px solid var(--border-dim);}
  .res-row:last-child{border-bottom:none;}
  .res-name{color:var(--text-dim);}
  .res-name.rare{color:var(--gold);}
  .res-name.super{color:var(--purple);}
  .res-name.special{color:var(--frost);}
  .res-val{font-family:'IBM Plex Mono',monospace;color:var(--text);}
  .empty-note{color:var(--text-dim);font-size:0.78rem;font-style:italic;}
  .equip-row{font-size:0.74rem;color:var(--frost);margin-top:8px;padding-top:8px;border-top:1px solid var(--border-dim);line-height:1.6;}
  .equip-row .gate{color:var(--ember);}

  .event-banner{background:rgba(157,127,201,0.12);border:1px solid var(--purple);border-radius:2px;padding:8px 12px;margin-bottom:12px;font-size:0.8rem;color:var(--purple);}
  .event-banner b{color:var(--text);}

  .main-panel{min-height:440px;display:flex;flex-direction:column;}
  .scene-title{font-family:'Spectral',serif;font-size:1.25rem;font-weight:600;margin:0 0 6px;}
  .scene-desc{color:var(--text-dim);font-size:0.85rem;line-height:1.5;margin-bottom:14px;max-width:65ch;}
  .section-label{font-family:'IBM Plex Mono',monospace;font-size:0.66rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-dim);margin:14px 0 8px;}

  .btn-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:auto;padding-top:16px;}
  .btn-row.static{margin-top:0;padding-top:0;}
  .btn{font-family:'IBM Plex Sans',sans-serif;font-weight:600;font-size:0.82rem;padding:9px 15px;border-radius:2px;border:1px solid var(--border);background:var(--panel-alt);color:var(--text);cursor:pointer;transition:all .15s ease;}
  .btn:hover{border-color:var(--sky);background:#232b52;}
  .btn:disabled{opacity:0.35;cursor:not-allowed;}
  .btn.primary{background:var(--sky);border-color:var(--sky);color:#0c0f1e;}
  .btn.primary:hover{background:#6d97c8;}
  .btn.danger{border-color:var(--ember);color:var(--ember);background:transparent;}
  .btn.danger:hover{background:var(--danger-glow);}
  .btn.gold{border-color:var(--gold);color:var(--gold);background:transparent;}
  .btn.gold:hover{background:rgba(211,171,82,0.15);}
  .btn.moss{border-color:var(--moss);color:var(--moss);background:transparent;}
  .btn.moss:hover{background:rgba(122,154,99,0.15);}
  .btn.small{padding:6px 10px;font-size:0.72rem;}

  .island-box{display:flex;align-items:center;justify-content:center;padding:12px 10px 4px;}
  .island{position:relative;width:150px;height:150px;}
  .island svg{width:100%;height:100%;filter:drop-shadow(0 12px 18px rgba(0,0,0,0.5));}
  .land-meter{font-family:'IBM Plex Mono',monospace;font-size:0.68rem;color:var(--text-dim);text-align:center;margin-bottom:10px;}
  .land-meter b{color:var(--moss);}
  .struct-list{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:6px;}
  .struct-chip{background:var(--bg-deep);border:1px solid var(--border-dim);border-radius:2px;padding:6px 10px;font-size:0.76rem;display:flex;align-items:center;gap:8px;}
  .struct-chip b{color:var(--moss);}
  .struct-chip .tier-badge{font-family:'IBM Plex Mono',monospace;font-size:0.62rem;background:rgba(211,171,82,0.2);color:var(--gold);padding:1px 5px;border-radius:2px;}

  .zone-list{display:flex;flex-direction:column;gap:10px;margin-bottom:10px;}
  .zone-card{background:var(--bg-deep);border:1px solid var(--border-dim);border-radius:3px;padding:12px 14px;}
  .zone-card .zn{font-family:'Spectral',serif;font-weight:600;font-size:1rem;margin-bottom:4px;}
  .zone-card .zd{font-size:0.78rem;color:var(--text-dim);line-height:1.5;margin-bottom:8px;}
  .zone-tag{font-family:'IBM Plex Mono',monospace;font-size:0.65rem;padding:2px 6px;border-radius:2px;margin-right:6px;}
  .zone-tag.t1{background:rgba(122,154,99,0.2);color:var(--moss);}
  .zone-tag.t2{background:rgba(211,171,82,0.2);color:var(--gold);}
  .zone-tag.t3{background:rgba(157,127,201,0.2);color:var(--purple);}
  .zone-tag.event{background:rgba(157,127,201,0.3);color:var(--purple);}

  .exp-stats{display:flex;gap:16px;margin-bottom:12px;flex-wrap:wrap;}
  .exp-stat{font-family:'IBM Plex Mono',monospace;font-size:0.76rem;color:var(--text-dim);}
  .exp-stat b{color:var(--text);}
  .carried-box{background:var(--bg-deep);border:1px solid var(--border-dim);border-radius:2px;padding:10px 12px;margin-bottom:6px;min-height:34px;}
  .carried-box .res-name{color:var(--moss);}
  .cap-note{font-family:'IBM Plex Mono',monospace;font-size:0.68rem;color:var(--text-dim);margin-top:6px;}

  .consume-list{display:flex;flex-direction:column;gap:6px;margin-bottom:4px;}
  .consume-row{display:flex;justify-content:space-between;align-items:center;background:var(--bg-deep);border:1px solid var(--border-dim);border-radius:2px;padding:6px 10px;font-size:0.78rem;gap:10px;}
  .consume-row .cr-name{color:var(--text);}
  .consume-row .cr-meta{color:var(--text-dim);font-family:'IBM Plex Mono',monospace;font-size:0.68rem;}

  .leg-track{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap;}
  .leg-dot{width:22px;height:6px;border-radius:3px;background:var(--border-dim);}
  .leg-dot.done{background:var(--moss);}
  .leg-dot.current{background:var(--gold);}

  .beacon-box{background:var(--bg-deep);border:1px solid var(--gold);border-radius:3px;padding:16px;text-align:center;margin-bottom:16px;}
  .beacon-box .bicon{font-size:2rem;margin-bottom:8px;}

  .log-panel{margin-top:14px;}
  .log-entry{font-family:'IBM Plex Mono',monospace;font-size:0.75rem;padding:6px 0;border-bottom:1px solid var(--border-dim);color:var(--text-dim);line-height:1.4;}
  .log-entry:last-child{border-bottom:none;}
  .log-entry.good{color:var(--moss);}
  .log-entry.bad{color:var(--ember);}
  .log-entry.rare{color:var(--gold);}
  .log-entry.super{color:var(--purple);}
  .log-entry .tag{color:var(--text-dim);opacity:0.6;margin-right:6px;}

  .sys-overlay{position:fixed;inset:0;background:rgba(5,7,15,0.82);display:none;align-items:center;justify-content:center;z-index:50;padding:20px;}
  .sys-overlay.show{display:flex;}
  .sys-box{background:var(--panel);border:1px solid var(--gold);max-width:500px;width:100%;padding:26px 24px;border-radius:3px;position:relative;overflow:hidden;max-height:85vh;overflow-y:auto;}
  .sys-box::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(211,171,82,0.03) 0px,rgba(211,171,82,0.03) 1px,transparent 1px,transparent 3px);pointer-events:none;}
  .sys-box.danger{border-color:var(--ember);}
  .sys-tag{font-family:'IBM Plex Mono',monospace;font-size:0.68rem;letter-spacing:0.16em;color:var(--gold);text-transform:uppercase;margin-bottom:10px;}
  .sys-box.danger .sys-tag{color:var(--ember);}
  .sys-title{font-family:'Spectral',serif;font-size:1.3rem;font-weight:600;margin:0 0 10px;}
  .sys-body{font-size:0.86rem;color:var(--text-dim);line-height:1.55;margin-bottom:20px;}
  .sys-body b{color:var(--text);}
  .sys-actions{display:flex;gap:10px;flex-wrap:wrap;}
  .sys-btn{font-family:'IBM Plex Mono',monospace;font-size:0.78rem;letter-spacing:0.05em;background:var(--gold);color:#0c0f1e;border:none;padding:10px 18px;border-radius:2px;cursor:pointer;font-weight:600;}
  .sys-box.danger .sys-btn{background:var(--ember);}
  .sys-btn:hover{opacity:0.88;}
  .sys-btn.secondary{background:transparent;border:1px solid var(--border);color:var(--text-dim);}

  .combat-vs{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;gap:16px;flex-wrap:wrap;}
  .combatant{flex:1;min-width:180px;}
  .combatant-name{font-family:'Spectral',serif;font-weight:600;font-size:1rem;margin-bottom:6px;}
  .combatant.enemy .combatant-name{color:var(--ember);}
  .combat-log{background:var(--bg-deep);border:1px solid var(--border-dim);border-radius:2px;padding:10px 12px;max-height:130px;overflow-y:auto;margin-bottom:14px;font-family:'IBM Plex Mono',monospace;font-size:0.74rem;color:var(--text-dim);}
  .combat-log div{padding:2px 0;}

  .build-list{display:flex;flex-direction:column;gap:8px;margin-bottom:10px;}
  .build-cat{font-family:'IBM Plex Mono',monospace;font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--gold);margin:10px 0 2px;}
  .build-cat:first-child{margin-top:0;}
  .build-item{background:var(--bg-deep);border:1px solid var(--border-dim);border-radius:2px;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;}
  .build-item .bi-name{font-weight:600;font-size:0.85rem;}
  .build-item .bi-cost{font-family:'IBM Plex Mono',monospace;font-size:0.7rem;color:var(--text-dim);}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <h1>SKY<span>FALL</span></h1>
      <div class="subtitle" id="playerNameTag">Extraction Survival on a Floating Plot</div>
    </div>
    <div class="day-counter">DAY <b id="dayNum">1</b><span class="trial-note" id="trialNote"></span></div>
  </header>

  <div class="grid">
    <div>
      <div class="panel">
        <div class="panel-title">Operator</div>
        <div class="lvl-row"><span class="lvl" id="lvlVal">Lv. 1</span><span style="font-family:'IBM Plex Mono',monospace;font-size:0.68rem;color:var(--text-dim);" id="xpText">0/80 XP</span></div>
        <div class="bar-track"><div class="bar-fill xp" id="xpBar" style="width:0%"></div></div>

        <div class="bar-label"><span>HEALTH</span><span id="healthText">100/100</span></div>
        <div class="bar-track"><div class="bar-fill health" id="healthBar" style="width:100%"></div></div>
        <div class="bar-label"><span>HUNGER</span><span id="hungerText">100/100</span></div>
        <div class="bar-track"><div class="bar-fill hunger" id="hungerBar" style="width:100%"></div></div>
        <div class="bar-label"><span>THIRST</span><span id="thirstText">100/100</span></div>
        <div class="bar-track"><div class="bar-fill thirst" id="thirstBar" style="width:100%"></div></div>
        <div class="bar-label"><span>STAMINA</span><span id="staminaText">100/100</span></div>
        <div class="bar-track"><div class="bar-fill stamina" id="staminaBar" style="width:100%"></div></div>
        <div class="bar-label"><span>TEMPERATURE</span><span id="tempText">Neutral</span></div>
        <div class="bar-track"><div class="bar-fill temp" id="tempBar" style="width:50%"></div></div>
        <div class="bar-label"><span>CARRY WEIGHT</span><span id="weightText">0/40</span></div>
        <div class="bar-track"><div class="bar-fill weight" id="weightBar" style="width:0%"></div></div>

        <div class="attrs" id="attrsBox"></div>
        <div class="points-banner" id="pointsBanner">points available</div>
        <div class="equip-row" id="equipRow"></div>
      </div>

      <div class="panel">
        <div class="panel-title">Home Storage <span id="storageCount" style="color:var(--text-dim);font-weight:400;"></span></div>
        <div class="land-meter" style="text-align:left;margin-bottom:8px;" id="storageCapNote"></div>
        <div class="res-list" id="storageList"></div>
      </div>
    </div>

    <div>
      <div class="panel main-panel" id="mainPanel"></div>
      <div class="panel log-panel">
        <div class="panel-title">System Log</div>
        <div id="logList"></div>
      </div>
    </div>
  </div>
</div>

<div class="sys-overlay" id="sysOverlay">
  <div class="sys-box" id="sysBox">
    <div class="sys-tag" id="sysTag">// SYSTEM</div>
    <div class="sys-title" id="sysTitle">Notice</div>
    <div class="sys-body" id="sysBody">...</div>
    <div class="sys-actions" id="sysActions"></div>
  </div>
</div>

<div id="charCreateScreen" style="display:none;min-height:100vh;align-items:center;justify-content:center;padding:24px;">
  <div class="panel" style="max-width:440px;width:100%;">
    <div class="panel-title">// SYSTEM — New Operator</div>
    <h2 class="scene-title" style="font-family:'Spectral',serif;">Welcome to Skyfall</h2>
    <div id="charCreateBody"></div>
  </div>
</div>

<script>
/* =========================================================
   SKYFALL v7
   Extraction beacon activation, level-gated equipment tiers,
   richer food chain, jackpot finds, world events.
   ========================================================= */

const RESOURCE_META = {
  wood:    {label:'Wood',   tier:'common', weight:3, stack:12, gatherAmt:[1,3]},
  stone:   {label:'Stone',  tier:'common', weight:3, stack:12, gatherAmt:[1,2]},
  metal:   {label:'Metal',  tier:'rare',   weight:4, stack:6,  gatherAmt:[1,1]},
  tools:   {label:'Tools',  tier:'rare',   weight:3, stack:6,  gatherAmt:[1,1]},
  fiber:   {label:'Fiber',  tier:'common', weight:1, stack:10, gatherAmt:[1,3]},
  herb:    {label:'Herb',   tier:'rare',   weight:1, stack:8,  gatherAmt:[1,1]},
  leather: {label:'Leather',tier:'rare',   weight:2, stack:8,  gatherAmt:[1,1]},
  seeds:   {label:'Seeds',  tier:'rare',   weight:1, stack:6,  gatherAmt:[1,1]},
  ticket:  {label:'Land Expansion Ticket', tier:'super', weight:0, stack:3, special:true},

  water:      {label:'Water',        tier:'common', weight:1, stack:10, gatherAmt:[1,2], consumable:true, thirstRestore:30},
  apple:      {label:'Apple',        tier:'common', weight:1, stack:8,  gatherAmt:[1,2], consumable:true, nutrition:16, shelfLife:4},
  berries:    {label:'Berries',      tier:'common', weight:1, stack:10, gatherAmt:[1,3], consumable:true, nutrition:11, shelfLife:3},
  vegetable:  {label:'Vegetable',    tier:'common', weight:1, stack:8,  gatherAmt:[1,2], consumable:true, nutrition:18, shelfLife:5},
  mushroom:   {label:'Mushroom',     tier:'common', weight:1, stack:8,  gatherAmt:[1,2], consumable:true, nutrition:13, shelfLife:4},
  grain:      {label:'Grain',        tier:'common', weight:1, stack:10, gatherAmt:[1,2], consumable:true, nutrition:15, shelfLife:9},
  meat_raw:   {label:'Raw Meat',     tier:'rare',   weight:2, stack:6,  gatherAmt:[1,1], consumable:true, nutrition:24, shelfLife:2, rawRisk:true},
  fish_raw:   {label:'Raw Fish',     tier:'rare',   weight:1, stack:6,  gatherAmt:[1,1], consumable:true, nutrition:20, shelfLife:2, rawRisk:true},

  cooked_meat:    {label:'Cooked Meat',      tier:'rare', weight:1, stack:8,  special:true, consumable:true, nutrition:34, healthRestore:3, shelfLife:4},
  cooked_fish:    {label:'Cooked Fish',      tier:'rare', weight:1, stack:8,  special:true, consumable:true, nutrition:29, healthRestore:3, shelfLife:4},
  roasted_veg:    {label:'Roasted Vegetable',tier:'rare', weight:1, stack:8,  special:true, consumable:true, nutrition:27, healthRestore:4, shelfLife:7},
  porridge:       {label:'Porridge',         tier:'rare', weight:1, stack:8,  special:true, consumable:true, nutrition:24, thirstRestore:12, healthRestore:2, shelfLife:6},
  dried_fruit:    {label:'Dried Fruit',      tier:'rare', weight:1, stack:10, special:true, consumable:true, nutrition:14, shelfLife:14},
  dried_meat:     {label:'Dried Meat',       tier:'rare', weight:1, stack:10, special:true, consumable:true, nutrition:30, shelfLife:16},
  preserved_meal: {label:'Preserved Meal',   tier:'super',weight:1, stack:6,  special:true, consumable:true, nutrition:42, healthRestore:12, shelfLife:20},
  rare_ration:    {label:'Rare Ration',      tier:'super',weight:1, stack:4,  special:true, consumable:true, nutrition:50, healthRestore:8, shelfLife:12},

  medicine:        {label:'Medicine',        tier:'rare',  weight:1, stack:6, gatherAmt:[1,1], consumable:true, healthRestore:35, staminaRestore:15},
  bandage:         {label:'Bandage',         tier:'rare',  weight:1, stack:8, special:true, consumable:true, healthRestore:25},
  strong_medicine: {label:'Strong Medicine', tier